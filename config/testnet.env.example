# VigiChain testnet node — example environment.
# Export these before launching, or copy to `.env`.

# Network to join. This distribution is for the public testnet.
VIGI_NETWORK=testnet

# WHERE YOUR MINING REWARDS GO. Set this to your own VigiWallet address.
#
# Paste the receive address from VigiWallet and the coinbase of every block you produce — the
# subsidy AND the fees — is paid straight to it. The block is still signed by your node's own
# identity; only the payout destination changes.
#
# There is no registration anywhere and no account with anyone. Consensus pays the address written
# in the block, so the reward lands on a key nobody but you controls. If you leave this unset, the
# rewards go to your node's own generated identity instead, which is fine but harder to spend from.
#
# Get it wrong and the node refuses to start rather than mining to an address you do not own.
VIGI_MINER_ADDRESS=tvigi1youraddresshere

# Bootstrap peers, in the order the node tries them.
#
# The .onion is FIRST because it is the route that reaches this network today. `seed-04`'s direct
# TCP 28719 resolves but is not open to the Internet — verified from an external vantage point — so
# a node given only that name starts cleanly and never finds a peer. It is kept second so a node
# picks it up automatically if that port is ever opened.
#
# The Tor route needs a SOCKS proxy on YOUR machine (see VIGI_TOR_SOCKS_ADDR below). It is
# NAT-independent, so you do not need to open any port of your own.
VIGI_BOOTNODES=tor://2k2us2joevlvnja7i74dbfre3krmwmi3cbft5pvz4t3rtguzoha7xzyd.onion:28719,seed-04.vigichain.org:28719

# Where your local Tor SOCKS proxy listens. Default shown; change only if yours differs.
#   Debian/Ubuntu : sudo apt install tor && sudo systemctl enable --now tor
#   Fedora        : sudo dnf install tor && sudo systemctl enable --now tor
#   macOS         : brew install tor && brew services start tor
# VIGI_TOR_SOCKS_ADDR=127.0.0.1:9050

# The legacy WebSocket relay is unauthenticated broadcast transport and is disabled fail-closed.
# Leave unset or explicitly set off. A URL is rejected by the remediated node.
VIGI_RELAY_URL=off

# Where chain data and the node identity keystore are stored.
# VIGI_DATA_DIR=./vigi-data

# Node identity keystore path (created once, owner-only, never printed).
# VIGI_NODE_KEY_PATH=./vigi-data/node_key.json
