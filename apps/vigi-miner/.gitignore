# Build output and dependencies never belong in a repository whose policy is that nothing
# unattested sits in the tree — and `node_modules` in particular would add tens of thousands of
# files nobody reviews. The icons are generated by build.rs on every build, for the same reason.
node_modules/
dist/
src-tauri/target/
src-tauri/icons/

# Tauri regenerates these schemas from tauri.conf.json on every build.
src-tauri/gen/
