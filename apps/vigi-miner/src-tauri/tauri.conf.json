{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vigi Miner",
  "version": "0.3.0",
  "identifier": "org.vigichain.miner",
  "build": {"beforeDevCommand":"npm run dev","devUrl":"http://localhost:1420","beforeBuildCommand":"npm run build","frontendDist":"../dist"},
  "app": {
    "windows": [{"title":"Vigi Miner · Mission Control","width":1440,"height":960,"minWidth":1040,"minHeight":720,"resizable":true,"fullscreen":false,"decorations":true}],
    "security": {"csp":"default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost; connect-src ipc: http://ipc.localhost"}
  },
  "bundle": {"active":true,"targets":"all"}
}
